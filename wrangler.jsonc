// The Yxra API Worker. Deployed by .github/workflows/deploy.yml, which swaps
// in the Hyperdrive id from the HYPERDRIVE_ID repository variable.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yxra-api",
  "main": "api-worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Tico's Review list page: public/admin.html is served at /admin.
  "assets": { "directory": "public", "html_handling": "drop-trailing-slash" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "HYPERDRIVE_ID",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/yxra_test"
    }
  ],
  "vars": { "NODE_ENV": "production" },
  "observability": { "enabled": true },
  // A preview copy (.github/workflows/deploy-preview.yml) with its own name, so
  // the live yxra-api Worker is untouched. Same Supabase data; no ADMIN_TOKEN,
  // so its admin routes stay shut.
  "env": {
    "preview": {
      "name": "yxra-api-preview",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "HYPERDRIVE_ID" }],
      "vars": { "NODE_ENV": "production" }
    }
  }
}
