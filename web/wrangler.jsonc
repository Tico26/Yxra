// The Amara's Pick website Worker: the Vite build in dist/, served as static files,
// with worker.js in front of the addresses listed in run_worker_first.
// Deployed by .github/workflows/deploy.yml after the API Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaras-pick-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // /privacy serves privacy.html; unknown addresses get 404.html with a 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/go/*",
      "/products",
      "/products/*",
      "/shops",
      "/shops/*",
      "/login",
      "/signup",
      "/saved",
      "/auth",
      "/account",
      "/how-yxra-makes-money",
      "/how-yxra-makes-money/"
    ]
  },
  // Calls to the API go straight to the amaras-pick-api Worker, not over the internet.
  "services": [{ "binding": "API", "service": "amaras-pick-api" }],
  "observability": { "enabled": true }
}
